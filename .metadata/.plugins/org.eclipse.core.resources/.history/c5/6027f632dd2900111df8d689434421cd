static void standFrontLeftLeg(void)
{
	PWM_SetAngle(&pwm1Ch1, 90); // Heap
	PWM_SetAngle(&pwm2Ch1, 90); // Thigh
	PWM_SetAngle(&pwm3Ch1, 10); // Knee
}

static void foldFrontLeftLeg(void)
{
	PWM_SetAngle(&pwm1Ch1, 90); // Heap
	PWM_SetAngle(&pwm2Ch1, 135); // Thigh
	PWM_SetAngle(&pwm3Ch1,   0); // Knee
}

static void standFrontRightLeg(void)
{
	PWM_SetAngle(&pwm1Ch3, 90);
	PWM_SetAngle(&pwm2Ch3, 90);
	PWM_SetAngle(&pwm3Ch3, 10);
}

static void foldFrontRightLeg(void)
{
	PWM_SetAngle(&pwm1Ch3, 90);
	PWM_SetAngle(&pwm2Ch3, 135);
	PWM_SetAngle(&pwm3Ch3, 0);
}

static void foldRearLeftLeg(void)
{
	PWM_SetAngle(&pwm1Ch2, 90);
	PWM_SetAngle(&pwm2Ch2, 135);
	PWM_SetAngle(&pwm3Ch2, 0);
}
static void standRearLeftLeg(void)
{
	PWM_SetAngle(&pwm1Ch2, 90);
	PWM_SetAngle(&pwm2Ch2, 90);
	PWM_SetAngle(&pwm3Ch2, 15);
}

static void foldRearRightLeg(void)
{
	PWM_SetAngle(&pwm1Ch4, 90);
	PWM_SetAngle(&pwm2Ch4, 135);
	PWM_SetAngle(&pwm3Ch4, 0);
}

static void standRearRightLeg(void)
{
	PWM_SetAngle(&pwm1Ch4, 90);
	PWM_SetAngle(&pwm2Ch4, 90);
	PWM_SetAngle(&pwm3Ch4, 15);
}

static void standLegs(void)
{
	standFrontLeftLeg();
	standFrontRightLeg();
	standRearLeftLeg();
	standRearRightLeg();
}

static void foldLegs(void)
{
	foldFrontLeftLeg();
	foldFrontRightLeg();
	foldRearLeftLeg();
	foldRearRightLeg();
}

// [수정 포인트 1] 물리적 한계에 맞춘 각도 재설정
const float THIGH_MID = 110.0f;
const float THIGH_RANGE = 20.0f;

// [설정] Knee: 무릎 (45도 더 앞으로 이동하여 충돌 방지)
// 기존 80도에서 더 앞으로(펴지는 방향) 이동하여 중심점을 50~60도로 잡습니다.
const float KNEE_MID = 55.0f;
const float KNEE_RANGE = 35.0f; // 가동 범위를 넓혀서 시원하게 뻗도록 설정

float gait_t = 0.0f;
const float gait_speed = 0.012f; // 보행 속도 (약간 천천히 테스트)
uint32_t last_gait_tick = 0;
void App_Loop(void)
{
//	foldLegs();
//	HAL_Delay(1000);
//	standLegs();
//	HAL_Delay(1000);

	if (HAL_GetTick() - last_gait_tick >= 15)
	    {
	        last_gait_tick = HAL_GetTick();

	        gait_t += gait_speed;
	        if (gait_t > 1.0f) gait_t -= 1.0f;

	        // 1. Thigh (허벅지) 3차 이징 계산
	        float thigh_t = (gait_t < 0.5f) ? (gait_t * 2.0f) : (2.0f - gait_t * 2.0f);
	        float thigh_f = thigh_t * thigh_t * (3.0f - 2.0f * thigh_t);
	        float thigh_angle = (THIGH_MID - THIGH_RANGE) + (2.0f * THIGH_RANGE * thigh_f);

	        // 2. Knee (무릎) 3차 이징 계산 (위상차 0.25 적용)
	        float knee_t_raw = gait_t + 0.25f;
	        if (knee_t_raw > 1.0f) knee_t_raw -= 1.0f;

	        float knee_t = (knee_t_raw < 0.5f) ? (knee_t_raw * 2.0f) : (2.0f - knee_t_raw * 2.0f);
	        float knee_f = knee_t * knee_t * (3.0f - 2.0f * knee_t);

	        // 3. 무릎 각도 산출 (전방으로 뻗는 범위 강조)
	        float knee_angle = (KNEE_MID - KNEE_RANGE) + (2.0f * KNEE_RANGE * knee_f);

	        // [안전장치] 물리적 충돌 리미트 (예: 20도 이하로 내려가면 기어 보호)
	        if (knee_angle < 20.0f) knee_angle = 20.0f;

	        // 4. 출력
	        PWM_SetAnglePrecision(&pwm2Ch3, thigh_angle);
	        PWM_SetAnglePrecision(&pwm3Ch3, knee_angle);
	    }
